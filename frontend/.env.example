# Firebase project name: digital-wellness
# All fields below are required — there is no offline/demo fallback.
# Prediction runs entirely client-side (TensorFlow.js) — no backend URL needed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=digital-wellness.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=digital-wellness
VITE_FIREBASE_STORAGE_BUCKET=digital-wellness.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
