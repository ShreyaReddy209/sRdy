{
  "manifest_version": 3,
  "name": "WellSense Tracker",
  "version": "1.2.4",
  "description": "Passively tracks domain, category, and focus patterns for your WellSense dashboard.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WellSense Tracker"
  },
  "permissions": ["tabs", "idle", "storage", "alarms"],
  "host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*"
  ]
}
